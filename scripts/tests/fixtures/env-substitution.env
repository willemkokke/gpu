# Test: Substitution should use expanded env vars, not file values
# Scenario: TOOLS_FOLDER is set in environment (e.g., CI sets ~/.tools)
# but .env has a different default value. Other vars reference TOOLS_FOLDER.
TOOLS_FOLDER=.tools
UV_CACHE_DIR=${TOOLS_FOLDER}/uv/cache
UV_PYTHON_DIR=${TOOLS_FOLDER}/uv/python
